<UserControl
    x:Class="BndzFinder.StageManager.Controls.StageManagerStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="StripRoot" CornerRadius="12" Padding="8"
            Background="#B01A1A1A" BorderBrush="#20FFFFFF" BorderThickness="1"
            VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="WindowThumbnails" Orientation="Horizontal" Spacing="8" />
        </ScrollViewer>
    </Border>
</UserControl>
