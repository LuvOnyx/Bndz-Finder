<UserControl
    x:Class="BndzFinder.Finder.Controls.FinderBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="FinderRoot">
        <Border x:Name="FinderGlass" BorderThickness="0,0,0,1" BorderBrush="#15FFFFFF">
            <Border.Background>
                <AcrylicBrush TintColor="#E8101010" TintOpacity="0.75" FallbackColor="#E8101010" />
            </Border.Background>

            <Grid Padding="12,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE80F;" FontSize="12" Foreground="#CCFFFFFF" />
                    <TextBlock x:Name="AppTitle" Text="Bndz-Finder" FontSize="12" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1" />

                <StackPanel x:Name="StatusCluster" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="CpuWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed" Click="OnCpuClick">
                        <TextBlock x:Name="CpuText" FontSize="11" />
                    </Button>
                    <Button x:Name="GpuWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed">
                        <TextBlock x:Name="GpuText" FontSize="11" />
                    </Button>
                    <Button x:Name="MemoryWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed">
                        <TextBlock x:Name="MemoryText" FontSize="11" />
                    </Button>
                    <Button x:Name="DiskWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed">
                        <TextBlock x:Name="DiskText" FontSize="11" />
                    </Button>
                    <Button x:Name="BatteryWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed">
                        <TextBlock x:Name="BatteryText" FontSize="11" />
                    </Button>
                    <Button x:Name="NetworkWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE701;" FontSize="11" />
                    </Button>
                    <Button x:Name="WeatherWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed">
                        <TextBlock x:Name="WeatherText" FontSize="11" />
                    </Button>
                    <Button x:Name="AudioWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed" Click="OnAudioClick">
                        <FontIcon Glyph="&#xE767;" FontSize="11" />
                    </Button>
                    <Button x:Name="BluetoothWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed" Click="OnBluetoothClick">
                        <FontIcon Glyph="&#xE702;" FontSize="11" />
                    </Button>
                    <Button x:Name="DisplayWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed" Click="OnDisplayClick">
                        <FontIcon Glyph="&#xE7F4;" FontSize="11" />
                    </Button>
                    <Button x:Name="KeyboardWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed">
                        <TextBlock x:Name="KeyboardText" FontSize="11" />
                    </Button>
                    <Button x:Name="MediaWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE768;" FontSize="11" />
                    </Button>
                    <Button x:Name="NotificationsWidget" Style="{StaticResource FinderWidgetButton}" Visibility="Collapsed">
                        <FontIcon Glyph="&#xEA8F;" FontSize="11" />
                    </Button>
                    <ItemsControl x:Name="TrayIcons" />
                    <Button x:Name="ClockWidget" Style="{StaticResource FinderWidgetButton}" Click="OnCalendarClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="DateText" FontSize="11" Opacity="0.8" />
                            <TextBlock x:Name="ClockText" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
