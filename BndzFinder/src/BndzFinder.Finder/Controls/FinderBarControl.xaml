<UserControl
    x:Class="BndzFinder.Finder.Controls.FinderBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="MenuBarItem" TargetType="Button">
            <Setter Property="Padding" Value="8,0,8,0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="MenuBarAppTitle" TargetType="Button" BasedOn="{StaticResource MenuBarItem}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,0,10,0" />
        </Style>
        <Style x:Key="StatusItem" TargetType="Button">
            <Setter Property="Padding" Value="5,0,5,0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="FinderRoot" Height="24">
        <!-- Full-bleed frosted menu bar (not a floating card) -->
        <Border x:Name="FinderGlass" BorderThickness="0,0,0,0.5" BorderBrush="#22FFFFFF">
            <Border.Background>
                <AcrylicBrush
                    x:Name="MenuAcrylic"
                    TintColor="#1C1C1E"
                    TintOpacity="0.55"
                    TintLuminosityOpacity="0.95"
                    FallbackColor="#E01C1C1E" />
            </Border.Background>

            <Grid Padding="8,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Apple mark + active app + menus -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                    <Button x:Name="AppleMenuButton" Style="{StaticResource MenuBarItem}"
                            Padding="6,0,8,0" Click="OnAppleMenuClick" ToolTipService.ToolTip="Apple menu">
                        <Grid Width="14" Height="16">
                            <Image x:Name="AppleMarkImage" Width="12" Height="14" Stretch="Uniform" Visibility="Collapsed" />
                            <Path x:Name="AppleMarkPath" Width="12" Height="14" Stretch="Uniform" Fill="#F2FFFFFF"
                                  Data="M12.8,4.3c-0.7,0.9-1.9,1.5-3,1.4c-0.1-1.2,0.5-2.4,1.2-3.2C11.7,1.6,12.9,1,13.9,1 C14,2.2,13.5,3.4,12.8,4.3z M14,6.1c-1.4-0.1-2.6,0.8-3.3,0.8c-0.7,0-1.8-0.8-3-0.7c-1.5,0-2.9,0.9-3.7,2.3 c-1.6,2.7-0.4,6.8,1.1,9c0.8,1.1,1.7,2.3,2.9,2.2c1.1-0.1,1.6-0.7,3-0.7c1.4,0,1.8,0.7,3,0.7c1.2,0,2-1.1,2.8-2.2 c0.9-1.3,1.2-2.6,1.3-2.6C15.9,14.7,12.2,13.4,14,6.1z" />
                        </Grid>
                    </Button>

                    <Button x:Name="AppTitleButton" Style="{StaticResource MenuBarAppTitle}" Click="OnAppMenuClick">
                        <TextBlock x:Name="AppTitle" Text="Finder" FontSize="13" FontWeight="SemiBold" />
                    </Button>

                    <Button x:Name="FileMenuButton" Style="{StaticResource MenuBarItem}" Content="File" Click="OnFileMenuClick" />
                    <Button x:Name="EditMenuButton" Style="{StaticResource MenuBarItem}" Content="Edit" Click="OnEditMenuClick" />
                    <Button x:Name="ViewMenuButton" Style="{StaticResource MenuBarItem}" Content="View" Click="OnViewMenuClick" />
                    <Button x:Name="WindowMenuButton" Style="{StaticResource MenuBarItem}" Content="Window" Click="OnWindowMenuClick" />
                    <Button x:Name="HelpMenuButton" Style="{StaticResource MenuBarItem}" Content="Help" Click="OnHelpMenuClick" />
                </StackPanel>

                <!-- Center: optional Stage Manager strip -->
                <Border Grid.Column="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Visibility="{x:Bind StageStripVisibility, Mode=OneWay}">
                        <StackPanel x:Name="StageStrip" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" />
                    </ScrollViewer>
                </Border>

                <!-- Right: status cluster (macOS Control Center style) -->
                <StackPanel x:Name="StatusCluster" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <!-- Compact metrics (optional) -->
                    <Button x:Name="CpuWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed" Click="OnCpuClick">
                        <TextBlock x:Name="CpuText" FontSize="11" Opacity="0.9" />
                    </Button>
                    <Button x:Name="GpuWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed">
                        <TextBlock x:Name="GpuText" FontSize="11" Opacity="0.9" />
                    </Button>
                    <Button x:Name="MemoryWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed">
                        <TextBlock x:Name="MemoryText" FontSize="11" Opacity="0.9" />
                    </Button>
                    <Button x:Name="DiskWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed">
                        <TextBlock x:Name="DiskText" FontSize="11" Opacity="0.9" />
                    </Button>
                    <Button x:Name="WeatherWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed">
                        <TextBlock x:Name="WeatherText" FontSize="11" Opacity="0.9" />
                    </Button>

                    <Button x:Name="BatteryWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE83F;" FontSize="12" />
                            <TextBlock x:Name="BatteryText" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NetworkWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed"
                            Click="OnNetworkClick" ToolTipService.ToolTip="Wi-Fi">
                        <FontIcon Glyph="&#xE701;" FontSize="13" />
                    </Button>
                    <Button x:Name="AudioWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed"
                            Click="OnAudioClick" ToolTipService.ToolTip="Sound">
                        <FontIcon Glyph="&#xE767;" FontSize="13" />
                    </Button>
                    <Button x:Name="BluetoothWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed"
                            Click="OnBluetoothClick" ToolTipService.ToolTip="Bluetooth">
                        <FontIcon Glyph="&#xE702;" FontSize="13" />
                    </Button>
                    <Button x:Name="DisplayWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed"
                            Click="OnDisplayClick" ToolTipService.ToolTip="Display">
                        <FontIcon Glyph="&#xE7F4;" FontSize="13" />
                    </Button>
                    <Button x:Name="KeyboardWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed">
                        <TextBlock x:Name="KeyboardText" FontSize="11" />
                    </Button>
                    <Button x:Name="MediaWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                    </Button>

                    <Button x:Name="SearchWidget" Style="{StaticResource StatusItem}" Click="OnSearchClick"
                            ToolTipService.ToolTip="Search">
                        <FontIcon Glyph="&#xE721;" FontSize="13" />
                    </Button>
                    <Button x:Name="ControlCenterWidget" Style="{StaticResource StatusItem}" Click="OnControlCenterClick"
                            ToolTipService.ToolTip="Control Center">
                        <FontIcon Glyph="&#xE9E9;" FontSize="13" />
                    </Button>
                    <Button x:Name="NotificationsWidget" Style="{StaticResource StatusItem}" Visibility="Collapsed"
                            Click="OnNotificationsClick" ToolTipService.ToolTip="Notifications">
                        <FontIcon Glyph="&#xEA8F;" FontSize="13" />
                    </Button>

                    <ItemsControl x:Name="TrayIcons" Margin="2,0,0,0" />

                    <Button x:Name="ClockWidget" Style="{StaticResource StatusItem}" Click="OnCalendarClick"
                            Padding="8,0,4,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="DateText" FontSize="13" Opacity="0.85" />
                            <TextBlock x:Name="ClockText" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
