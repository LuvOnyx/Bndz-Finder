<UserControl
    x:Class="BndzFinder.Finder.Controls.ControlCenterFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="14" Padding="16" MinWidth="280"
            Background="#E0181818" BorderBrush="#25FFFFFF" BorderThickness="1">
        <StackPanel x:Name="PanelRoot" Spacing="12">
            <TextBlock x:Name="PanelTitle" FontSize="14" FontWeight="SemiBold" />
            <StackPanel x:Name="WifiPanel" Spacing="8" Visibility="Collapsed">
                <ToggleSwitch Header="Wi-Fi" />
                <TextBlock Text="Connected network" Opacity="0.7" FontSize="11" />
            </StackPanel>
            <StackPanel x:Name="BluetoothPanel" Spacing="8" Visibility="Collapsed">
                <ToggleSwitch Header="Bluetooth" />
            </StackPanel>
            <StackPanel x:Name="AudioPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Output volume" FontSize="11" />
                <Slider Minimum="0" Maximum="100" Value="60" />
            </StackPanel>
            <StackPanel x:Name="DisplayPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Brightness" FontSize="11" />
                <Slider Minimum="0" Maximum="100" Value="80" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
