<UserControl
    x:Class="BndzFinder.Finder.Controls.ControlCenterFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="16" Padding="14" MinWidth="300"
            BorderBrush="#28FFFFFF" BorderThickness="1">
        <Border.Background>
            <AcrylicBrush TintColor="#1C1C1E" TintOpacity="0.55" TintLuminosityOpacity="0.95" FallbackColor="#E01C1C1E" />
        </Border.Background>
        <StackPanel x:Name="PanelRoot" Spacing="12">
            <TextBlock x:Name="PanelTitle" FontSize="13" FontWeight="SemiBold" Foreground="#F2FFFFFF" />
            <StackPanel x:Name="ControlPanel" Spacing="10" Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Padding="12" Background="#28FFFFFF">
                        <StackPanel Spacing="6">
                            <FontIcon Glyph="&#xE701;" FontSize="16" />
                            <TextBlock Text="Wi-Fi" FontSize="11" />
                            <ToggleSwitch />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="12" Padding="12" Background="#28FFFFFF">
                        <StackPanel Spacing="6">
                            <FontIcon Glyph="&#xE702;" FontSize="16" />
                            <TextBlock Text="Bluetooth" FontSize="11" />
                            <ToggleSwitch />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Text="Display" FontSize="11" Opacity="0.75" />
                <Slider Minimum="0" Maximum="100" Value="80" />
                <TextBlock Text="Sound" FontSize="11" Opacity="0.75" />
                <Slider Minimum="0" Maximum="100" Value="60" />
            </StackPanel>
            <StackPanel x:Name="WifiPanel" Spacing="8" Visibility="Collapsed">
                <ToggleSwitch Header="Wi-Fi" />
                <TextBlock Text="Network status" Opacity="0.7" FontSize="11" />
            </StackPanel>
            <StackPanel x:Name="BluetoothPanel" Spacing="8" Visibility="Collapsed">
                <ToggleSwitch Header="Bluetooth" />
            </StackPanel>
            <StackPanel x:Name="AudioPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Output volume" FontSize="11" Opacity="0.75" />
                <Slider Minimum="0" Maximum="100" Value="60" />
            </StackPanel>
            <StackPanel x:Name="DisplayPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Brightness" FontSize="11" Opacity="0.75" />
                <Slider Minimum="0" Maximum="100" Value="80" />
            </StackPanel>
            <StackPanel x:Name="MetricsPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="MetricsBody" FontSize="12" TextWrapping="WrapWholeWords" Opacity="0.9" />
            </StackPanel>
            <StackPanel x:Name="CalendarPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="CalendarBody" FontSize="13" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
