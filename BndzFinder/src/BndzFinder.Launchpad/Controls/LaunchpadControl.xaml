<UserControl
    x:Class="BndzFinder.Launchpad.Controls.LaunchpadControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.Background>
            <AcrylicBrush TintColor="#90101010" TintOpacity="0.85" FallbackColor="#B0101010" />
        </Grid.Background>

        <Grid Padding="48" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Grid.Row="0" PlaceholderText="Search"
                     Width="320" HorizontalAlignment="Center"
                     CornerRadius="12" />

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <GridView x:Name="AppGrid" SelectionMode="None" IsItemClickEnabled="True">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="7" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="8"
                                    Width="{Binding CellSize}" Height="{Binding CellSize}">
                                <StackPanel Spacing="8">
                                    <Image Source="{Binding IconUri}" Width="{Binding IconSize}" Height="{Binding IconSize}" Stretch="Uniform" />
                                    <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="{Binding IconSize}"
                                               Visibility="{Binding LabelVisibility}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Button x:Name="PrevPageButton" Content="◀" Click="OnPreviousPage" />
                <TextBlock x:Name="PageIndicator" VerticalAlignment="Center" Opacity="0.85" />
                <Button x:Name="NextPageButton" Content="▶" Click="OnNextPage" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
