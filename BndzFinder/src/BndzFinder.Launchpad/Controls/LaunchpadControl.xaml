<UserControl
    x:Class="BndzFinder.Launchpad.Controls.LaunchpadControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Border Background="#B0101010">
            <AcrylicBrush TintColor="#90101010" TintOpacity="0.85" />
        </Border>

        <Grid Padding="48" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Grid.Row="0" PlaceholderText="Search"
                     Width="320" HorizontalAlignment="Center"
                     CornerRadius="12" />

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AppGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="8" Width="96" Height="96">
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="48" />
                                    <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="80" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
