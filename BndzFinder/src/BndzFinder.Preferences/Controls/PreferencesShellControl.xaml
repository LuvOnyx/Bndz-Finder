<UserControl
    x:Class="BndzFinder.Preferences.Controls.PreferencesShellControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BndzFinder.Preferences.Controls">

    <Grid>
        <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        SelectionChanged="OnSectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General" />
                <NavigationViewItem Content="Appearance" Tag="Appearance" />
                <NavigationViewItem Content="System Icon Tray" Tag="SystemIconTray" />
                <NavigationViewItem Content="Screen" Tag="Screen" />
                <NavigationViewItem Content="Look and Behavior" Tag="LookAndBehavior" />
                <NavigationViewItem Content="Launchpad" Tag="Launchpad" />
                <NavigationViewItem Content="Window Animations" Tag="WindowAnimations" />
                <NavigationViewItem Content="Audio / Display / Network" Tag="AudioDisplayNetwork" />
                <NavigationViewItem Content="Hot Corners and Hotkeys" Tag="Advanced" />
                <NavigationViewItem Content="Themes" Tag="Themes" />
            </NavigationView.MenuItems>

            <ScrollViewer Padding="24">
                <StackPanel x:Name="SectionPanel" Spacing="16" MaxWidth="720">
                    <TextBlock x:Name="SectionTitle" FontSize="24" FontWeight="SemiBold" />

                    <StackPanel x:Name="GeneralSection" Spacing="12">
                        <TextBlock Text="Dock position" />
                        <ComboBox x:Name="DockPositionBox" Width="280" />
                        <TextBlock Text="Dock visibility" />
                        <ComboBox x:Name="DisplayModeBox" Width="280" />
                        <ComboBox x:Name="LanguageBox" Header="Language" Width="280" />
                    </StackPanel>

                    <StackPanel x:Name="AppearanceSection" Spacing="12" Visibility="Collapsed">
                        <local:PremiumColorPicker x:Name="AccentPicker" Label="Accent color" />
                        <local:PremiumColorPicker x:Name="GlassTintPicker" Label="Glass tint color" />
                        <TextBlock Text="Glass effect" />
                        <ComboBox x:Name="GlassEffectBox" Width="280" />
                        <TextBlock Text="Icon hover effect" />
                        <ComboBox x:Name="IconEffectBox" Width="280" />
                        <Slider x:Name="DockOpacitySlider" Header="Dock opacity" Minimum="20" Maximum="100" />
                        <Slider x:Name="CornerRadiusSlider" Header="Corner radius" Minimum="0" Maximum="48" />
                    </StackPanel>

                    <StackPanel x:Name="ScreenSection" Spacing="12" Visibility="Collapsed">
                        <ComboBox x:Name="DockMonitorBox" Header="Dock monitor" Width="280" />
                        <ComboBox x:Name="FinderMonitorBox" Header="Finder monitor" Width="280" />
                        <ToggleSwitch x:Name="ScreenRoundToggle" Header="Rounded screen corners (ScreenRound)" />
                        <Slider x:Name="ScreenRoundRadiusSlider" Header="Corner round radius" Minimum="8" Maximum="64" />
                    </StackPanel>

                    <StackPanel x:Name="LookAndBehaviorSection" Spacing="12" Visibility="Collapsed">
                        <ToggleSwitch x:Name="HideTaskbarToggle" Header="Hide Windows taskbar when dock is shown" />
                        <ToggleSwitch x:Name="HideTaskbarAllMonitorsToggle" Header="Hide taskbar on all monitors" />
                        <ToggleSwitch x:Name="AutoHideTaskbarToggle" Header="Auto-hide taskbar at startup" />
                        <ToggleSwitch x:Name="PreviewOnToggle" Header="Show window preview on dock hover" />
                        <Slider x:Name="PreviewSizeSlider" Header="Preview size" Minimum="120" Maximum="400" />
                        <Slider x:Name="PreviewDelaySlider" Header="Preview delay (ms)" Minimum="0" Maximum="1200" />
                        <Slider x:Name="HideDockDelaySlider" Header="Hide dock delay (ms)" Minimum="0" Maximum="2000" />
                        <ToggleSwitch x:Name="LockIconsToggle" Header="Lock dock icons from reorder" />
                        <ToggleSwitch x:Name="EdgeActivationToggle" Header="Show dock when pointer nears screen edge" />
                    </StackPanel>

                    <StackPanel x:Name="WidgetsSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Optional menu bar widgets — enable only what you want." TextWrapping="WrapWholeWords" Opacity="0.8" />
                        <ToggleSwitch x:Name="WidgetCpu" Header="CPU usage" />
                        <ToggleSwitch x:Name="WidgetGpu" Header="GPU usage" />
                        <ToggleSwitch x:Name="WidgetMemory" Header="Memory usage" />
                        <ToggleSwitch x:Name="WidgetDisk" Header="Disk usage" />
                        <ToggleSwitch x:Name="WidgetNetwork" Header="Network" />
                        <ToggleSwitch x:Name="WidgetBattery" Header="Battery" />
                        <ToggleSwitch x:Name="WidgetWeather" Header="Weather" />
                        <ToggleSwitch x:Name="WidgetAudio" Header="Sound" />
                        <ToggleSwitch x:Name="WidgetBluetooth" Header="Bluetooth" />
                        <ToggleSwitch x:Name="WidgetDisplay" Header="Display" />
                        <ToggleSwitch x:Name="WidgetKeyboard" Header="Keyboard layout" />
                        <ToggleSwitch x:Name="WidgetMedia" Header="Media controls" />
                        <ToggleSwitch x:Name="WidgetNotifications" Header="Notifications" />
                    </StackPanel>

                    <StackPanel x:Name="LaunchpadSection" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Launchpad opens as an overlay via hotkey — not forced at startup." TextWrapping="WrapWholeWords" Opacity="0.8" />
                        <Slider x:Name="LaunchpadIconSizeSlider" Header="Icon size" Minimum="48" Maximum="128" />
                        <ToggleSwitch x:Name="LaunchpadHideLabelsToggle" Header="Hide app labels" />
                        <ComboBox x:Name="LaunchpadSourceBox" Header="App catalog source" Width="280" />
                    </StackPanel>

                    <StackPanel x:Name="AudioDisplayNetworkSection" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Quick settings panels opened from Finder widgets." TextWrapping="WrapWholeWords" Opacity="0.8" />
                        <ToggleSwitch x:Name="AudioPanelToggle" Header="Sound / volume panel" />
                        <ToggleSwitch x:Name="DisplayPanelToggle" Header="Display / brightness panel" />
                        <ToggleSwitch x:Name="NetworkPanelToggle" Header="Network status widget" />
                        <ToggleSwitch x:Name="MicrophonePanelToggle" Header="Microphone widget" />
                        <Slider x:Name="TrayWaitSlider" Header="Tray icon poll interval (ms)" Minimum="250" Maximum="3000" />
                        <ToggleSwitch x:Name="AlwaysShowTrayToggle" Header="Always show all tray icons" />
                    </StackPanel>

                    <StackPanel x:Name="WindowAnimationsSection" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Minimize windows using" />
                        <ComboBox x:Name="MinimizeEffectBox" Width="280" />
                    </StackPanel>

                    <StackPanel x:Name="AdvancedSection" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Dock hotkey" />
                        <TextBox x:Name="DockHotkeyBox" Width="280" IsReadOnly="True" />
                        <TextBlock Text="Finder hotkey" />
                        <TextBox x:Name="FinderHotkeyBox" Width="280" IsReadOnly="True" />
                        <TextBlock Text="Launchpad hotkey" />
                        <TextBox x:Name="LaunchpadHotkeyBox" Width="280" IsReadOnly="True" />
                        <TextBlock Text="Stage Manager hotkey" />
                        <TextBox x:Name="StageManagerHotkeyBox" Width="280" IsReadOnly="True" />
                        <TextBlock Text="Bottom-left hot corner" />
                        <ComboBox x:Name="HotCornerLeftBox" Width="280" />
                        <TextBlock Text="Bottom-right hot corner" />
                        <ComboBox x:Name="HotCornerRightBox" Width="280" />
                    </StackPanel>

                    <StackPanel x:Name="ThemesSection" Spacing="12" Visibility="Collapsed">
                        <Button Content="Backup settings" Click="OnBackup" />
                    </StackPanel>

                    <Button x:Name="SaveButton" Content="Save" HorizontalAlignment="Left" Click="OnSave" />
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</UserControl>
