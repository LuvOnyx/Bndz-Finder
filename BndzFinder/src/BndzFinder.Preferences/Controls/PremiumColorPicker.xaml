<UserControl
    x:Class="BndzFinder.Preferences.Controls.PremiumColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="12" Padding="16" Background="#20181818" BorderBrush="#30FFFFFF" BorderThickness="1">
        <StackPanel Spacing="12">
            <TextBlock x:Name="PickerLabel" FontSize="12" Opacity="0.8" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SwatchPreview" Width="48" Height="48" CornerRadius="10"
                        BorderBrush="#40FFFFFF" BorderThickness="1" />
                <StackPanel Grid.Column="1" Spacing="8">
                    <Slider x:Name="HueSlider" Header="Hue" Minimum="0" Maximum="360" Value="210" />
                    <Slider x:Name="SaturationSlider" Header="Saturation" Minimum="0" Maximum="100" Value="80" />
                    <Slider x:Name="ValueSlider" Header="Brightness" Minimum="0" Maximum="100" Value="84" />
                    <TextBox x:Name="HexBox" PlaceholderText="#0078D4" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
