<UserControl
    x:Class="BndzFinder.Dock.Controls.DockBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BndzFinder.Dock.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Full-width AppBar strip; centered pill matches macOS dock chrome (Apple Design Resources metrics). -->
    <Grid x:Name="DockRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border
            x:Name="DockShadow"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="12,0,12,6"
            Opacity="0.22"
            CornerRadius="24"
            Background="#50000000"
            Translation="0,8,0" />

        <Border
            x:Name="GlassBackdrop"
            CornerRadius="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="12,0,12,10"
            BorderThickness="1"
            BorderBrush="#24FFFFFF"
            Translation="0,0,16">
            <Border.Background>
                <AcrylicBrush
                    x:Name="DockAcrylic"
                    TintColor="#CC1A1A1A"
                    TintOpacity="0.55"
                    TintLuminosityOpacity="0.85"
                    FallbackColor="#CC1A1A1A" />
            </Border.Background>
        </Border>

        <Canvas
            x:Name="IconCanvas"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="24,0,24,14"
            PointerMoved="OnPointerMoved"
            PointerExited="OnPointerExited" />
    </Grid>
</UserControl>
