<UserControl
    x:Class="BndzFinder.Dock.Controls.DockBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BndzFinder.Dock.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="DockRoot">
        <Border
            x:Name="GlassBackdrop"
            CornerRadius="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="12"
            BorderThickness="1"
            BorderBrush="#20FFFFFF"
            Translation="0,0,16">
            <Border.Background>
                <AcrylicBrush
                    x:Name="DockAcrylic"
                    TintColor="#CC1E1E1E"
                    TintOpacity="0.6"
                    FallbackColor="#CC1E1E1E" />
            </Border.Background>
        </Border>

        <Canvas
            x:Name="IconCanvas"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="24,0,24,14"
            PointerMoved="OnPointerMoved"
            PointerExited="OnPointerExited" />
    </Grid>
</UserControl>
