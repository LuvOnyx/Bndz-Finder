<UserControl
    x:Class="BndzFinder.Dock.Controls.DockIconControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" RenderTransformOrigin="0.5,1.0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="IconLift" Y="0" />
                <RotateTransform x:Name="IconTilt" Angle="0" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Icon shadow -->
        <Border
            x:Name="ShadowLayer"
            Background="#30000000"
            CornerRadius="14"
            Opacity="0"
            Margin="0,6,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom" />

        <!-- Reflection -->
        <Border
            x:Name="ReflectionLayer"
            Opacity="0"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Margin="0,8,0,-12"
            Height="20"
            Width="40"
            CornerRadius="12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Icon image -->
        <Border
            x:Name="IconBorder"
            Width="48"
            Height="48"
            CornerRadius="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
            <Grid>
                <Image x:Name="IconImage" Stretch="Uniform" />
                <!-- Light overlay -->
                <Border x:Name="LightOverlay" Opacity="0" CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#60FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="0.6" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Select ring -->
                <Border x:Name="SelectRing" Opacity="0" CornerRadius="12"
                        BorderBrush="#80FFFFFF" BorderThickness="2" />
            </Grid>
        </Border>

        <!-- Badge -->
        <Border x:Name="BadgeLayer" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-4,-4,0" Background="#FF3B30" CornerRadius="8" MinWidth="16" MinHeight="16"
                Padding="4,1" Visibility="Collapsed">
            <TextBlock x:Name="BadgeText" Foreground="White" FontSize="9" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- Progress bar -->
        <Border x:Name="ProgressLayer" Height="3" VerticalAlignment="Bottom" Margin="6,0,6,2"
                Background="#30FFFFFF" CornerRadius="2" Visibility="Collapsed">
            <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="#FFFFFFFF"
                    CornerRadius="2" Width="0" />
        </Border>

        <!-- Running indicator -->
        <Ellipse
            x:Name="RunningDot"
            Width="5"
            Height="5"
            Fill="White"
            Opacity="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,-2" />

        <!-- Hover label -->
        <Border
            x:Name="HoverLabel"
            Opacity="0"
            Padding="10,4"
            CornerRadius="8"
            Background="#CC1A1A1A"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,-28,0,0">
            <TextBlock x:Name="LabelText" Foreground="White" FontSize="11" />
        </Border>
    </Grid>
</UserControl>
