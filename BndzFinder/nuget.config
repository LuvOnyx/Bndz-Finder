<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Use nuget.org only for this solution (avoids broken user/machine feeds). -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <!-- Extra NuGet HTTP retries per request (helps flaky WiFi during large WinUI restores). -->
    <add key="http_retry_count" value="15" />
  </config>
</configuration>
